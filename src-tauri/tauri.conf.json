{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keepr",
  "version": "1.0.6",
  "identifier": "com.wayned.keepr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "python3 tools/helpbook.py && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keepr",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "visible": false
      },
      {
        "label": "tray",
        "url": "index.html?view=tray",
        "title": "Keepr",
        "width": 360,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Wayne Davies. Free software under the GNU General Public License, version 3 or later.",
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/Keepr.help": "gen/help/Keepr.help"
      }
    }
  }
}
